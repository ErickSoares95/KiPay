# Copie para infra/.env e troque as senhas. O .env nao vai para o Git.
POSTGRES_IMAGE=postgres:17.11-alpine
KAFKA_IMAGE=apache/kafka:4.2.2

ACCOUNTS_DB_NAME=accounts
ACCOUNTS_DB_USER=accounts
ACCOUNTS_DB_PASSWORD=troque-esta-senha-accounts

LEDGER_DB_NAME=ledger
LEDGER_DB_USER=ledger
LEDGER_DB_PASSWORD=troque-esta-senha-ledger

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4.7
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha-local
